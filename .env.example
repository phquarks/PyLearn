# Copy to .env and fill in from your Supabase project:
# Dashboard -> Project Settings -> API
#
# Both values are safe to expose in the browser: the anon key is public by
# design and every table is guarded by row level security. Never put the
# service_role key here - it bypasses RLS.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
